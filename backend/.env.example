# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uhhomes
DB_USER=root
DB_PASSWORD=your_mysql_password

# JWT
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Google OAuth (optional - needed for "Continue with Google")
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# SMTP Email (for OTP - optional in dev, OTP will be logged to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="UHHomes" <noreply@uhhomes.com>
SMTP_REPLY_TO=support@uhhomes.com

# --- Production email (recommended: transactional provider on your domain) ---
# Sending from a free @gmail.com address lands in spam regardless of content.
# Sign up at resend.com (or SendGrid/SES/Postmark), verify uhhomes.com
# (add the DKIM/SPF records they give you at your DNS provider), then:
#
#   Resend:   SMTP_HOST=smtp.resend.com   SMTP_USER=resend      SMTP_PASS=<api key>
#   SendGrid: SMTP_HOST=smtp.sendgrid.net SMTP_USER=apikey      SMTP_PASS=<api key>
#   SES:      SMTP_HOST=email-smtp.<region>.amazonaws.com  SMTP_USER/PASS=<smtp creds>
#
#   SMTP_FROM="UH Homes" <no-reply@uhhomes.com>
#
# Also add a DMARC record at your DNS provider:
#   _dmarc.uhhomes.com  TXT  "v=DMARC1; p=none; rua=mailto:postmaster@uhhomes.com"
